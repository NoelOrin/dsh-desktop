{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "DSH Desktop main window（本地页面）",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "global-shortcut:default",
    "notification:default",
    "clipboard-manager:allow-read-text",
    "clipboard-manager:allow-write-text",
    "dialog:default",
    "allow-get-status",
    "allow-restart",
    "allow-install-dsh",
    "allow-open-log-directory",
    "allow-get-config",
    "allow-set-config",
    "allow-open-external",
    "allow-get-autostart",
    "allow-set-autostart",
    "allow-register-shortcut",
    "allow-unregister-shortcut"
  ]
}
