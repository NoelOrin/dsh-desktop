{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DSH Desktop",
  "version": "0.1.0",
  "identifier": "ai.deepseek.dsh-desktop",
  "build": {
    "beforeDevCommand": "corepack yarn web:all",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "corepack yarn web:build",
    "frontendDist": "../../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "DSH Desktop",
        "width": 1280,
        "height": 860,
        "minWidth": 480,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "visible": true,
        "backgroundColor": "#f5f6fa"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
