{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "DSH Desktop main window（本地页面）",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-internal-toggle-maximize",
    "global-shortcut:default",
    "notification:default",
    "clipboard-manager:allow-read-text",
    "clipboard-manager:allow-write-text",
    "dialog:default",
    "allow-get-status",
    "allow-restart",
    "allow-install-dsh",
    "allow-open-log-directory",
    "allow-get-config",
    "allow-set-config",
    "allow-open-external",
    "allow-get-autostart",
    "allow-set-autostart",
    "allow-get-desktop-settings",
    "allow-set-desktop-settings",
    "allow-get-projects",
    "allow-add-project",
    "allow-update-project",
    "allow-remove-project",
    "allow-set-project-pinned",
    "allow-mark-project-read",
    "allow-archive-project-chats",
    "allow-create-project-worktree",
    "allow-show-project-in-finder",
    "allow-register-shortcut",
    "allow-unregister-shortcut",
    "allow-get-ui-theme",
    "allow-window-action",
    "allow-get-shortcuts",
    "allow-unregister-all-shortcuts",
    "allow-get-pending-deeplinks",
    "allow-ack-deeplink",
    "allow-request-notification-permission",
    "allow-update-dsh",
    "allow-open-paths",
    "allow-import-paths"
  ]
}
