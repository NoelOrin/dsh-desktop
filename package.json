{
  "name": "dsh-desktop",
  "private": true,
  "version": "0.3.0",
  "packageManager": "yarn@4.17.1",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "packages/plugins/*"
  ],
  "scripts": {
    "dev": "yarn workspace @dsh-desktop/shell dev",
    "build": "yarn workspace @dsh-desktop/shell build",
    "dev:web": "yarn workspace @dsh-desktop/shell web:all",
    "dev:shell": "node scripts/dev.mjs",
    "dev:plugins": "node scripts/watch-plugins.mjs",
    "build:web": "yarn workspace @dsh-desktop/shell web:build",
    "tauri": "yarn workspace @dsh-desktop/shell tauri",
    "lan-proxy": "node scripts/lan-proxy.mjs",
    "build:plugins": "node scripts/build-plugins.mjs",
    "typecheck": "yarn workspaces foreach -A --exclude dsh-desktop -p -t run typecheck",
    "lint": "biome check",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "postinstall": "lefthook install"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "lefthook": "^2.1.10",
    "tsdown": "^0.22"
  }
}
