{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "bridge",
  "description": "DSH web（loopback 远程页面）受控桥接能力：仅对 127.0.0.1 端口白名单开放最小命令切片",
  "windows": ["main"],
  "remote": {
    "urls": ["http://127.0.0.1:*"]
  },
  "permissions": [
    "notification:allow-notify",
    "clipboard-manager:allow-read-text",
    "clipboard-manager:allow-write-text",
    "dialog:allow-open",
    "dialog:allow-save",
    "allow-get-status",
    "allow-restart",
    "allow-install-dsh",
    "allow-open-log-directory",
    "allow-get-config",
    "allow-set-config",
    "allow-open-external"
  ]
}