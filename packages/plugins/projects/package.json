{
  "name": "@dsh-desktop/plugin-projects",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "yarn@4.17.1",
  "description": "项目 host 插件：为侧边栏右键菜单提供 dsh 工作区/会话数据与动作端点",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsdown": "^0.22",
    "typescript": "^5"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dshDesktop": {
    "id": "projects"
  }
}
