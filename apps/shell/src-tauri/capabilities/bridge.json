{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "bridge",
  "description": "DSH web（loopback 远程页面）受控桥接能力：仅对 127.0.0.1 端口白名单开放最小命令切片",
  "windows": ["main"],
  "remote": {
    "urls": ["http://127.0.0.1:*"]
  },
  "permissions": [
    "core:window:allow-start-dragging",
    "core:window:allow-internal-toggle-maximize",
    "notification:allow-notify",
    "clipboard-manager:allow-read-text",
    "clipboard-manager:allow-write-text",
    "dialog:allow-open",
    "dialog:allow-save",
    "allow-get-status",
    "allow-restart",
    "allow-install-dsh",
    "allow-open-log-directory",
    "allow-get-config",
    "allow-set-config",
    "allow-open-external",
    "allow-get-autostart",
    "allow-set-autostart",
    "allow-get-desktop-settings",
    "allow-set-desktop-settings",
    "allow-register-shortcut",
    "allow-unregister-shortcut",
    "allow-check-update",
    "allow-install-update",
    "allow-window-action",
    "allow-get-shortcuts",
    "allow-unregister-all-shortcuts",
    "allow-get-pending-deeplinks",
    "allow-ack-deeplink",
    "allow-request-notification-permission",
    "allow-update-dsh",
    "allow-open-paths",
    "allow-import-paths"
  ]
}
