{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DSH Desktop",
  "version": "0.1.0",
  "identifier": "ai.deepseek.dsh-desktop",
  "build": {
    "beforeDevCommand": "corepack yarn web:all",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "corepack yarn web:build",
    "frontendDist": "../../../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "DSH Desktop",
        "width": 1280,
        "height": 860,
        "minWidth": 480,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "visible": true,
        "backgroundColor": "#f5f6fa"
      },
      {
        "label": "control",
        "title": "DSH 控制中心",
        "url": "/control-center/index.html",
        "width": 960,
        "height": 680,
        "minWidth": 480,
        "minHeight": 480,
        "center": true,
        "resizable": true,
        "visible": false,
        "backgroundColor": "#f7f8fa"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "deep-link": {
      "desktop": { "schemes": ["dsh-desktop"] }
    },
    "updater": {
      "endpoints": [
        "https://github.com/NoelOrin/dsh-desktop/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDcxQjU3NTlCODlDQ0E3REMKUldUY3A4eUptM1cxY1Q0OHNzTnIyLzhXbE96aVNON21ET0VMU09uWkRYaXh6RUFwWkNlM1lYU1cK"
    }
  }
}
